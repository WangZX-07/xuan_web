[Unit]
Description=LungTic control service
After=network-online.target clamav-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=lungtic-app
Group=lungtic-runtime
SupplementaryGroups=lungtic-web
WorkingDirectory=/opt/lungtic/current/server
EnvironmentFile=/etc/lungtic/lungtic.env
ExecStart=/opt/lungtic/current/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 9100 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lungtic-data

[Install]
WantedBy=multi-user.target

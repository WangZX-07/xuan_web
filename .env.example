# Runtime
LUNGTIC_ENVIRONMENT=production
LUNGTIC_HOST=127.0.0.1
LUNGTIC_PORT=9100
LUNGTIC_PUBLIC_ORIGIN=https://respulse.top
LUNGTIC_ADMIN_ORIGIN=https://console.respulse.top
LUNGTIC_DATABASE_URL=sqlite:////srv/lungtic-data/lungtic.sqlite3
LUNGTIC_DATA_DIR=/srv/lungtic-data
LUNGTIC_SESSION_COOKIE_SECURE=true
LUNGTIC_IP_HASH_SALT=replace-with-a-long-random-secret

# Feishu enterprise self-built application
LUNGTIC_FEISHU_APP_ID=
LUNGTIC_FEISHU_APP_SECRET=
LUNGTIC_FEISHU_ALLOWED_TENANT_KEYS=
LUNGTIC_FEISHU_ALLOWED_DEPARTMENT_IDS=
LUNGTIC_FEISHU_OWNER_OPEN_IDS=
LUNGTIC_FEISHU_REDIRECT_URI=https://console.respulse.top/auth/feishu/callback

# ClamAV daemon: unavailable means release publication is blocked
LUNGTIC_CLAMAV_HOST=127.0.0.1
LUNGTIC_CLAMAV_PORT=3310
LUNGTIC_CLAMAV_TIMEOUT_SECONDS=180

# Upload limits
LUNGTIC_UPLOAD_CHUNK_SIZE=8388608
LUNGTIC_UPLOAD_MAX_BYTES=1073741824
LUNGTIC_ASSET_MAX_BYTES=25165824
LUNGTIC_MINIMUM_FREE_BYTES=2147483648
